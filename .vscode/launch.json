{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "Launch Express Server",
			"skipFiles": ["<node_internals>/**"],
			"program": "${workspaceFolder}/CalorieCalculator/server.js",
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"env": {
				"NODE_ENV": "development"
			},
			"outFiles": ["${workspaceFolder}/**/*.js"]
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Run Mocha Tests",
			"skipFiles": ["<node_internals>/**"],
			"program": "${workspaceFolder}/CalorieCalculator/node_modules/mocha/bin/_mocha",
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"args": ["--timeout", "5000", "--recursive", "CalorieCalculator/test/**/*.js"],
			"env": {
				"NODE_ENV": "test"
			},
			"outFiles": ["${workspaceFolder}/**/*.js"]
		}
	]
}
